
# Certificates and profiles are stored in the existing private HeJuNo/Match-Secrets repository
# (the same one used by LoopWorkspace). HTTPS + GH_PAT (git_basic_authorization in the Fastfile)
# is used instead of SSH so that GitHub Actions runners can access it without an SSH key.
GITHUB_REPOSITORY_OWNER ||= ENV["GITHUB_REPOSITORY_OWNER"] || "HeJuNo"

git_url("https://github.com/#{GITHUB_REPOSITORY_OWNER}/Match-Secrets.git")

storage_mode("git")

type("appstore")

# The docs are available on https://docs.fastlane.tools/actions/match
