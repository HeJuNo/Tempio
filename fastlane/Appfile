# Tempio — the bundle identifier is derived from the TEAMID secret at build time.
TEMPIO_TEAMID = ENV["TEAMID"]

app_identifier("com.#{TEMPIO_TEAMID}.tempio")
team_id(TEMPIO_TEAMID) if TEMPIO_TEAMID && !TEMPIO_TEAMID.empty?

